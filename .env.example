# Neon Postgres — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon Postgres — direct connection (used by Prisma Migrate)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# If your machine can't reach Neon's hostname over TCP (DNS resolves fine but connections hang —
# often a broken/stale IPv6 default route causing the resolver to prefer an IPv6 address that
# doesn't actually route), connect via IPv4 directly and pass Neon's endpoint ID as a connection
# option instead of relying on SNI-based hostname routing:
#   1. `getent ahostsv4 <your-neon-hostname>` to get an IPv4 address for it
#   2. Replace `host` in the URL with that IPv4 address
#   3. Add `&options=endpoint%3D<endpoint-id>` (the `ep-...` part of the original hostname,
#      including the `-pooler` suffix for DATABASE_URL, without it for DIRECT_URL)
# See CLAUDE.md's Commands section for the full rationale. Re-check the IPv4 address if the
# connection ever stops working — Neon's proxy IPs aren't guaranteed permanent.

AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Optional — only needed if Google OAuth is added later
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
